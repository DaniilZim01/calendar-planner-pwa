{
  "version": 2,
  "buildCommand": "mkdir -p dist/public && echo '<html><body><h1>Calendar Planner PWA</h1><p>API: <a href=\"/api/health\">/api/health</a>, <a href=\"/api/test\">/api/test</a></p></body></html>' > dist/public/index.html && echo 'Build completed: created dist/public'",
  "builds": [
    { "src": "dist/public/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "crons": [
    { "path": "/api/maintenance/cleanup-completed", "schedule": "0 3 * * *" },
    { "path": "/api/maintenance/notify-morning", "schedule": "0 6 * * *" }
  ]
}
